# The Asaborake web UI.
#
# One image serving both the built client and the Elysia server that proxies to
# the engine, so a deployment is one process and one port.

FROM oven/bun:1 AS build

WORKDIR /app

COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile

COPY web/ ./
RUN bun run build

FROM oven/bun:1-slim

WORKDIR /app

# Only what the server needs at runtime: its own source, the built client, and
# the production dependency tree.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
COPY --from=build /app/package.json ./

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

USER bun

CMD ["bun", "run", "server/index.ts"]
